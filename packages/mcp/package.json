{
  "name": "@web3mcp/mcp",
  "version": "0.0.1",
  "description": "One MCP server for every EVM contract that publishes Web3MCP tools",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Team-Managed/EVM-Web3MCP.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "web3mcp-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p . && esbuild ../approve-ui/src/page.ts ../approve-ui/src/page.css --bundle --minify --format=esm --platform=browser --target=es2022 --outdir=dist/approve && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --target=node22 --minify --legal-comments=none --outfile=../../plugins/claude-code/server/web3mcp.mjs && node -e \"require('node:fs').cpSync('dist/approve', '../../plugins/claude-code/server/approve', { recursive: true })\"",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@web3mcp/evm": "^0.0.1",
    "viem": "^2.57.16",
    "zod": "^4.6.7"
  }
}
