{
  "name": "@web3mcp/publisher",
  "version": "0.0.1",
  "private": true,
  "description": "CLI for protocol authors: validate a manifest, check it against the chain, and print the ENS records to publish",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "web3mcp-publish": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p . && npm run bundle",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=esm --target=node22 --minify --legal-comments=none --outfile=../../plugins/claude-code/skills/web3mcp-build/scripts/web3mcp-publish.mjs",
    "test": "node --test \"test/*.test.ts\""
  },
  "dependencies": {
    "@arkiv-network/sdk": "^1.0.1",
    "@web3mcp/evm": "^0.0.1",
    "@web3mcp/mcp": "^0.0.1",
    "viem": "^2.57.16"
  }
}
